+    def _forget_scope_on_close(self, context: Context[Any, Any], scope_key: str) -> None:
+        """Drop the session's budgets when its connection closes (registered once per connection)."""
+        connection = _connection_of(context)
+        if connection is None:  # pragma: no cover - a scope key implies a connection
+            return
+        marker = f"mcp.server.mcpserver.limits.forget_scope:{id(self)}"
+        if connection.state.get(marker):
+            return
+        connection.state[marker] = True
+        connection.exit_stack.callback(lambda: self.enforcer.forget_scope(scope_key))
