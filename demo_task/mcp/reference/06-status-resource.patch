 from pydantic import BaseModel, Field
 
@@ -219,6 +219,22 @@ class LimitEnforcer:
             return None
         return decision.remaining + 1 if decision.allowed else 0
 
+    def snapshot(
+        self, tools: dict[str, LimitPolicy], scope_key: str | None, now: float | None = None
+    ) -> dict[str, Any]:
+        """A JSON-serializable usage report for `tools`, as seen from `scope_key`. Records nothing."""
+        now = self._now(now)
+        return {
+            "tools": {
+                name: {
+                    "policy": policy.model_dump(mode="json"),
+                    "remaining": self.remaining(name, policy, scope_key, now),
+                    "scope": policy.scope,
+                }
+                for name, policy in tools.items()
+            }
+        }
+
     def forget_scope(self, scope_key: str) -> None:
         """Drop every session-scoped state tracked under `scope_key`, for all tools."""
         for key in [k for k in self._states if isinstance(k, tuple) and k[1] == scope_key]:
