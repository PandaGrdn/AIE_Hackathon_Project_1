+@app.command()
+def limits(
+    file_spec: str = typer.Argument(
+        ...,
+        help="Python file to inspect, optionally with :object suffix",
+    ),
+) -> None:
+    """Print each tool's rate limit, quota and scope without running the server."""
+    file, server_object = _parse_file_path(file_spec)
+    server = _import_server(file, server_object)
+    table = format_limits_table([(tool.name, tool.limits) for tool in server._tool_manager.list_tools()])
+    if table:
+        typer.echo(table)
+
