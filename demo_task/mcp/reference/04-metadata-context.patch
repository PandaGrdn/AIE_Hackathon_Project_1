Date: Sat, 7 Nov 2026 13:18:44 -0800
Subject: [PATCH 4/7] S4: client-visible limit metadata and context helpers

MCPServer.list_tools() publishes each policy under _meta["limits"] (merged
into a copy of the tool's meta); Context.tool_limits() and
Context.remaining_calls() expose the policy and the calls left now.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/mcp/server/mcpserver/context.py           |  19 +++
 src/mcp/server/mcpserver/server.py            |   6 +-
 .../mcpserver/test_limits_s4_metadata.py      | 161 ++++++++++++++++++
 3 files changed, 185 insertions(+), 1 deletion(-)
 create mode 100644 tests/server/mcpserver/test_limits_s4_metadata.py

diff --git a/src/mcp/server/mcpserver/context.py b/src/mcp/server/mcpserver/context.py
index 5f77583..095de58 100644
--- a/src/mcp/server/mcpserver/context.py
+++ b/src/mcp/server/mcpserver/context.py
@@ -26,6 +26,7 @@ from mcp.shared.subscriptions import (
 )
 
 if TYPE_CHECKING:
+    from mcp.server.mcpserver.limits import LimitPolicy
     from mcp.server.mcpserver.server import MCPServer
 
 
@@ -332,6 +333,24 @@ class Context(BaseModel, Generic[LifespanContextT, RequestT]):
         """
         return self.request_context.session.client_capabilities
 
+    def tool_limits(self, name: str) -> LimitPolicy | None:
+        """The limit policy of the named tool; `None` for an unknown tool or one without a policy."""
+        return self.mcp_server._tool_manager.get_limits(name)  # pyright: ignore[reportPrivateUsage]
+
+    def remaining_calls(self, name: str) -> int | None:
+        """Calls to the named tool this session could make right now.
+
+        `None` for an unknown tool or one without a policy. Inside a tool body the
+        current call is not counted yet: it is recorded once the tool returns.
+        """
+        from mcp.server.mcpserver.tools.tool_manager import session_scope_key
+
+        tool_manager = self.mcp_server._tool_manager  # pyright: ignore[reportPrivateUsage]
+        policy = tool_manager.get_limits(name)
+        if policy is None:
+            return None
+        return tool_manager.enforcer.remaining(name, policy, session_scope_key(self))
+
     @property
     def session(self):
         """Access to the underlying session for advanced usage."""
diff --git a/src/mcp/server/mcpserver/server.py b/src/mcp/server/mcpserver/server.py
