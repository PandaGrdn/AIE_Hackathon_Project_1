diff --git a/tests/server/mcpserver/test_limits_s2_tool_policies.py b/tests/server/mcpserver/test_limits_s2_tool_policies.py
new file mode 100644
index 0000000..ff59f9c
--- /dev/null
+++ b/tests/server/mcpserver/test_limits_s2_tool_policies.py
@@ -0,0 +1,92 @@
+"""S2: attaching limit policies to tools."""
+
+import pytest
+
+from mcp.server.mcpserver.exceptions import ToolError
+from mcp.server.mcpserver.limits import LimitPolicy, Quota, RateLimit
+from mcp.server.mcpserver.tools import Tool, ToolManager
+
+POLICY = LimitPolicy(rate_limit=RateLimit(max_calls=2, per_seconds=60), quota=Quota(max_calls=10))
+
+
+def search(query: str) -> str:  # pragma: no cover
+    return query
+
+
+def other() -> str:  # pragma: no cover
+    return "other"
+
+
+def test_tool_defaults_to_no_limits():
+    assert Tool.from_function(search).limits is None
+
+
+def test_from_function_accepts_limits():
+    tool = Tool.from_function(search, limits=POLICY)
+    assert tool.limits == POLICY
+
+
+def test_add_tool_passes_limits_through():
+    manager = ToolManager()
+    tool = manager.add_tool(search, limits=POLICY)
+    assert tool.limits == POLICY
+    assert manager.get_limits("search") == POLICY
+
+
+def test_add_tool_without_limits():
+    manager = ToolManager()
+    manager.add_tool(search)
+    assert manager.get_limits("search") is None
+
+
+def test_duplicate_add_tool_keeps_the_existing_policy():
+    manager = ToolManager(warn_on_duplicate_tools=False)
+    first = manager.add_tool(search, limits=POLICY)
+    again = manager.add_tool(search, limits=LimitPolicy(quota=Quota(max_calls=1)))
+    assert again is first
+    assert manager.get_limits("search") == POLICY
+
+
+def test_duplicate_add_tool_without_limits_keeps_the_policy():
+    manager = ToolManager(warn_on_duplicate_tools=False)
+    manager.add_tool(search, limits=POLICY)
+    manager.add_tool(search)
+    assert manager.get_limits("search") == POLICY
+
+
+def test_get_limits_unknown_tool_is_none():
+    assert ToolManager().get_limits("nope") is None
+
+
+def test_set_limits_replaces_and_clears():
+    manager = ToolManager()
+    manager.add_tool(search)
+    manager.set_limits("search", POLICY)
+    assert manager.get_limits("search") is POLICY
+    tool = manager.get_tool("search")
+    assert tool is not None and tool.limits is POLICY
+
+    session_policy = LimitPolicy(quota=Quota(max_calls=1), scope="session")
+    manager.set_limits("search", session_policy)
+    assert manager.get_limits("search") == session_policy
+
+    manager.set_limits("search", None)
+    assert manager.get_limits("search") is None
+
+
+def test_set_limits_only_touches_the_named_tool():
+    manager = ToolManager()
+    manager.add_tool(search)
+    manager.add_tool(other)
+    manager.set_limits("search", POLICY)
+    assert manager.get_limits("other") is None
+
+
+def test_set_limits_unknown_tool_raises_tool_error():
+    with pytest.raises(ToolError, match="Unknown tool: missing"):
+        ToolManager().set_limits("missing", POLICY)
+
+
+def test_tool_manager_init_keeps_prebuilt_tool_limits():
+    manager = ToolManager(tools=[Tool.from_function(search, limits=POLICY)])
+    assert manager.get_limits("search") == POLICY
