+    def get_limits(self, name: str) -> LimitPolicy | None:
+        """The limit policy attached to a tool; `None` when it has none or the tool is unknown."""
+        tool = self._tools.get(name)
+        return None if tool is None else tool.limits
+
+    def set_limits(self, name: str, policy: LimitPolicy | None) -> None:
+        """Attach `policy` to a registered tool, or clear it with `None`.
+
+        Raises:
+            ToolError: If the tool is unknown.
+        """
+        tool = self._tools.get(name)
+        if tool is None:
+            raise ToolError(f"Unknown tool: {name}")
+        tool.limits = policy
