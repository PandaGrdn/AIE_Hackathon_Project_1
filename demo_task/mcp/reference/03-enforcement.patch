+def session_scope_key(context: Context[Any, Any]) -> str | None:
+    """The scope key of the client session a call through `context` belongs to.
+
+    `None` (session-scoped limits fall back to server scope) when there is no
+    request context or the connection speaks a stateless 2026-07-28+ protocol
+    version, where every request gets a fresh connection. Otherwise the
+    transport's session id when it has one (streamable HTTP), else an id for
+    the connection object, which lives as long as the client connection.
+    """
+    try:
+        request_context = context.request_context
+    except ValueError:
+        return None
+    # The `ServerSession` is rebuilt for every request, so its identity says
+    # nothing; the `Connection` it wraps persists across a client's requests.
+    connection = getattr(request_context.session, "_connection", None)
+    if not isinstance(connection, Connection):
+        return None
+    if connection.protocol_version in MODERN_PROTOCOL_VERSIONS:
+        return None
+    if isinstance(connection.session_id, str):
+        return connection.session_id
+    return f"connection:{id(connection)}"
+
