+++ b/tests/server/mcpserver/test_limits_s3_enforcement.py
@@ -0,0 +1,468 @@
+"""S3: enforcing limit policies when a tool is called."""
+
+from typing import Any
+from unittest.mock import MagicMock
+
+import pytest
+from mcp_types import CallToolResult, InputRequiredResult, TextContent
+
+from mcp.client import Client
+from mcp.server.connection import Connection
+from mcp.server.context import ServerRequestContext
+from mcp.server.mcpserver import Context, MCPServer
+from mcp.server.mcpserver.exceptions import ToolError
+from mcp.server.mcpserver.limits import LimitEnforcer, LimitPolicy, Quota, RateLimit
+from mcp.server.mcpserver.tools import ToolManager
+from mcp.server.mcpserver.tools.tool_manager import session_scope_key
+from mcp.server.session import ServerSession
+
+pytestmark = pytest.mark.anyio
+
+
+class FakeClock:
+    def __init__(self, now: float = 100.0) -> None:
+        self.now = now
+
+    def __call__(self) -> float:
+        return self.now
+
+
+def rate(max_calls: int, per_seconds: float, **kwargs: Any) -> LimitPolicy:
+    return LimitPolicy(rate_limit=RateLimit(max_calls=max_calls, per_seconds=per_seconds), **kwargs)
+
+
+def quota(max_calls: int, **kwargs: Any) -> LimitPolicy:
+    return LimitPolicy(quota=Quota(max_calls=max_calls), **kwargs)
+
+
+def make_connection(session_id: str | None = None, protocol_version: str = "2025-11-25") -> Connection:
+    return Connection(MagicMock(), protocol_version=protocol_version, session_id=session_id)
+
+
+def context_for(connection: Connection) -> Context:
+    """A Context for one request on `connection`; each call builds a fresh ServerSession, as the runner does."""
+    request_context: ServerRequestContext[Any, Any] = ServerRequestContext(
+        session=ServerSession(MagicMock(), connection),
+        lifespan_context={},
+        protocol_version=connection.protocol_version,
+        method="tools/call",
+    )
+    return Context(request_context=request_context)
+
+
+def context_for_session(session_id: str) -> Context:
+    return context_for(make_connection(session_id))
+
+
+def limited_server(clock: FakeClock) -> MCPServer:
+    mcp = MCPServer()
+    mcp._tool_manager.enforcer = LimitEnforcer(clock=clock)
+    return mcp
+
+
+def error_text(result: CallToolResult) -> str:
+    assert result.is_error is True
+    content = result.content[0]
+    assert isinstance(content, TextContent)
+    return content.text
+
+
+class TestLimitEnforcer:
+    def test_uses_the_injected_clock(self):
+        clock = FakeClock(0.0)
+        enforcer = LimitEnforcer(clock=clock)
+        policy = rate(1, 10)
+        enforcer.record("t", policy, None)
+        clock.now = 9.0
+        decision = enforcer.decide("t", policy, None)
+        assert decision.allowed is False
+        assert decision.retry_after == pytest.approx(1.0)
+        clock.now = 10.0
+        assert enforcer.decide("t", policy, None).allowed is True
+
+    def test_explicit_now_overrides_the_clock(self):
+        enforcer = LimitEnforcer(clock=FakeClock(1000.0))
+        policy = rate(1, 10)
+        enforcer.record("t", policy, None, now=0.0)
+        assert enforcer.decide("t", policy, None, now=5.0).allowed is False
+        assert enforcer.decide("t", policy, None, now=10.0).allowed is True
+
+    def test_default_clock_is_monotonic(self):
+        enforcer = LimitEnforcer()
+        assert enforcer.decide("t", quota(1), None).allowed is True
+
+    def test_decide_does_not_record(self):
+        enforcer = LimitEnforcer(clock=FakeClock())
+        policy = quota(1)
+        for _ in range(3):
+            assert enforcer.decide("t", policy, None).allowed is True
+
+    def test_remaining(self):
+        enforcer = LimitEnforcer(clock=FakeClock())
+        policy = quota(3)
+        assert enforcer.remaining("t", policy, None) == 3
+        enforcer.record("t", policy, None)
+        assert enforcer.remaining("t", policy, None) == 2
+        enforcer.record("t", policy, None)
+        enforcer.record("t", policy, None)
+        assert enforcer.remaining("t", policy, None) == 0
+
+    def test_remaining_is_none_for_an_empty_policy(self):
+        assert LimitEnforcer(clock=FakeClock()).remaining("t", LimitPolicy(), None) is None
+
+    def test_tools_have_separate_state(self):
+        enforcer = LimitEnforcer(clock=FakeClock())
+        policy = quota(1)
+        enforcer.record("a", policy, None)
+        assert enforcer.decide("a", policy, None).allowed is False
+        assert enforcer.decide("b", policy, None).allowed is True
+
+    def test_server_scope_ignores_scope_key(self):
+        enforcer = LimitEnforcer(clock=FakeClock())
+        policy = quota(1)
+        enforcer.record("t", policy, "s1")
+        assert enforcer.decide("t", policy, "s2").allowed is False
+        assert enforcer.decide("t", policy, None).allowed is False
+
+    def test_session_scope_keys_by_scope_key(self):
+        enforcer = LimitEnforcer(clock=FakeClock())
+        policy = quota(1, scope="session")
+        enforcer.record("t", policy, "s1")
+        assert enforcer.decide("t", policy, "s1").allowed is False
+        assert enforcer.decide("t", policy, "s2").allowed is True
+
+    def test_session_scope_without_key_falls_back_to_server_state(self):
+        enforcer = LimitEnforcer(clock=FakeClock())
+        session_policy = quota(1, scope="session")
+        enforcer.record("t", session_policy, None)
+        assert enforcer.decide("t", session_policy, None).allowed is False
+        assert enforcer.decide("t", session_policy, "s1").allowed is True
+
+    def test_reset_one_tool(self):
+        enforcer = LimitEnforcer(clock=FakeClock())
+        server_policy = quota(1)
+        session_policy = quota(1, scope="session")
+        enforcer.record("a", server_policy, None)
+        enforcer.record("b", server_policy, None)
+        enforcer.record("s", session_policy, "k")
+        enforcer.reset("a")
+        enforcer.reset("s")
+        assert enforcer.decide("a", server_policy, None).allowed is True
+        assert enforcer.decide("b", server_policy, None).allowed is False
+        assert enforcer.decide("s", session_policy, "k").allowed is True
+
+    def test_reset_all(self):
+        enforcer = LimitEnforcer(clock=FakeClock())
+        policy = quota(1)
+        enforcer.record("a", policy, None)
+        enforcer.record("b", policy, None)
+        enforcer.reset()
+        assert enforcer.decide("a", policy, None).allowed is True
+        assert enforcer.decide("b", policy, None).allowed is True
+
+    def test_changed_policy_starts_from_empty_history(self):
+        enforcer = LimitEnforcer(clock=FakeClock())
+        enforcer.record("t", quota(2), None)
+        enforcer.record("t", quota(2), None)
+        assert enforcer.decide("t", quota(2), None).reason == "quota"
+        assert enforcer.remaining("t", quota(3), None) == 3
+        # The old history was discarded, not merely hidden.
+        assert enforcer.remaining("t", quota(2), None) == 2
+
+    def test_clock_called_only_when_now_is_none(self):
+        ticks: list[float] = []
+
+        def clock() -> float:
+            ticks.append(1.0)
+            return 1.0
+
+        enforcer = LimitEnforcer(clock=clock)
+        policy = quota(3)
+        enforcer.record("t", policy, None, now=0.5)
+        enforcer.decide("t", policy, None, now=0.5)
+        enforcer.remaining("t", policy, None, now=0.5)
+        assert ticks == []
+        enforcer.decide("t", policy, None)
+        assert ticks == [1.0]
+
+
+def echo(value: str) -> str:
+    return value
+
+
+class TestToolManagerCallTool:
+    async def test_rate_limit_message(self):
+        clock = FakeClock(0.0)
+        manager = ToolManager(enforcer=LimitEnforcer(clock=clock))
+        manager.add_tool(echo, limits=rate(2, 1.5))
+        assert await manager.call_tool("echo", {"value": "a"}, Context()) == "a"
+        clock.now = 0.25
+        assert await manager.call_tool("echo", {"value": "b"}, Context()) == "b"
+        clock.now = 0.5
+        with pytest.raises(ToolError) as exc_info:
+            await manager.call_tool("echo", {"value": "c"}, Context())
+        assert str(exc_info.value) == "Tool 'echo' rate limit exceeded; retry after 1.000s"
+
+    async def test_retry_after_is_formatted_to_three_decimals(self):
+        clock = FakeClock(0.0)
+        manager = ToolManager(enforcer=LimitEnforcer(clock=clock))
+        manager.add_tool(echo, limits=rate(1, 2))
+        await manager.call_tool("echo", {"value": "a"}, Context())
+        clock.now = 0.12345
+        with pytest.raises(ToolError, match=r"^Tool 'echo' rate limit exceeded; retry after 1\.877s$"):
+            await manager.call_tool("echo", {"value": "b"}, Context())
+
+    async def test_window_boundary(self):
+        clock = FakeClock(0.0)
+        manager = ToolManager(enforcer=LimitEnforcer(clock=clock))
+        manager.add_tool(echo, limits=rate(1, 10))
+        await manager.call_tool("echo", {"value": "a"}, Context())
+        clock.now = 9.999
+        with pytest.raises(ToolError, match="rate limit exceeded"):
+            await manager.call_tool("echo", {"value": "b"}, Context())
+        clock.now = 10.0
+        assert await manager.call_tool("echo", {"value": "c"}, Context()) == "c"
+
+    async def test_quota_message(self):
+        manager = ToolManager(enforcer=LimitEnforcer(clock=FakeClock()))
+        manager.add_tool(echo, limits=quota(1))
+        await manager.call_tool("echo", {"value": "a"}, Context())
+        with pytest.raises(ToolError) as exc_info:
+            await manager.call_tool("echo", {"value": "b"}, Context())
+        assert str(exc_info.value) == "Tool 'echo' quota exhausted"
+
+    async def test_quota_wins_over_rate_limit(self):
+        manager = ToolManager(enforcer=LimitEnforcer(clock=FakeClock()))
+        manager.add_tool(
+            echo, limits=LimitPolicy(rate_limit=RateLimit(max_calls=1, per_seconds=60), quota=Quota(max_calls=1))
+        )
+        await manager.call_tool("echo", {"value": "a"}, Context())
+        with pytest.raises(ToolError) as exc_info:
+            await manager.call_tool("echo", {"value": "b"}, Context())
+        assert str(exc_info.value) == "Tool 'echo' quota exhausted"
+
+    async def test_failing_call_does_not_consume_budget(self):
+        manager = ToolManager(enforcer=LimitEnforcer(clock=FakeClock()))
+        calls: list[bool] = []
+
+        def flaky(fail: bool) -> str:
+            calls.append(fail)
+            if fail:
+                raise ValueError("boom")
+            return "ok"
+
+        manager.add_tool(flaky, limits=quota(1))
+        for _ in range(3):
+            with pytest.raises(ToolError, match="Error executing tool flaky"):
+                await manager.call_tool("flaky", {"fail": True}, Context())
+        assert await manager.call_tool("flaky", {"fail": False}, Context()) == "ok"
+        with pytest.raises(ToolError, match="^Tool 'flaky' quota exhausted$"):
+            await manager.call_tool("flaky", {"fail": False}, Context())
+        assert calls == [True, True, True, False]
+
+    async def test_invalid_arguments_do_not_consume_budget(self):
+        manager = ToolManager(enforcer=LimitEnforcer(clock=FakeClock()))
+        manager.add_tool(echo, limits=quota(1))
+        with pytest.raises(ToolError, match="Error executing tool echo"):
+            await manager.call_tool("echo", {}, Context())
+        assert await manager.call_tool("echo", {"value": "a"}, Context()) == "a"
+
+    async def test_denied_call_does_not_run_the_tool(self):
+        manager = ToolManager(enforcer=LimitEnforcer(clock=FakeClock()))
+        runs: list[int] = []
+
+        def counted() -> int:
+            runs.append(1)
+            return len(runs)
+
+        manager.add_tool(counted, limits=quota(2))
+        await manager.call_tool("counted", {}, Context())
