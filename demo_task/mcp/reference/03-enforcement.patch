+
+_StateKey = str | tuple[str, str]
+
+
+class LimitEnforcer:
+    """Tracks calls per tool and decides whether the next one is allowed.
+
+    Server-scoped policies share one `LimitState` per tool name; session-scoped
+    policies get one per `(tool_name, scope_key)`. A session-scoped policy with
+    no `scope_key` falls back to the server-scoped state.
+    """
+
+    def __init__(self, clock: Callable[[], float] = time.monotonic) -> None:
+        self.clock = clock
+        self._states: dict[_StateKey, LimitState] = {}
+
+    @staticmethod
+    def _key(tool_name: str, policy: LimitPolicy, scope_key: str | None) -> _StateKey:
+        if policy.scope == "session" and scope_key is not None:
+            return (tool_name, scope_key)
+        return tool_name
+
+    def _state(self, tool_name: str, policy: LimitPolicy, scope_key: str | None, *, store: bool) -> LimitState:
+        key = self._key(tool_name, policy, scope_key)
+        state = self._states.get(key)
+        if state is None or state.policy != policy:
+            # First use, or the policy changed (e.g. `set_limits`): start from an empty history.
+            state = LimitState(policy)
+            if store:
+                self._states[key] = state
+            else:
+                self._states.pop(key, None)
+        return state
+
+    def _now(self, now: float | None) -> float:
+        return self.clock() if now is None else now
+
+    def decide(
+        self, tool_name: str, policy: LimitPolicy, scope_key: str | None, now: float | None = None
+    ) -> LimitDecision:
+        """Decide whether a call is allowed now, without recording it."""
+        return self._state(tool_name, policy, scope_key, store=False).check(self._now(now))
+
+    def record(self, tool_name: str, policy: LimitPolicy, scope_key: str | None, now: float | None = None) -> None:
+        """Record a completed call."""
+        self._state(tool_name, policy, scope_key, store=True).record(self._now(now))
+
+    def remaining(
+        self, tool_name: str, policy: LimitPolicy, scope_key: str | None, now: float | None = None
+    ) -> int | None:
+        """Calls that may still be made right now; `None` when the policy sets no limit."""
+        decision = self.decide(tool_name, policy, scope_key, now)
+        if decision.remaining is None:
+            return None
+        return decision.remaining + 1 if decision.allowed else 0
+
+    def reset(self, tool_name: str | None = None) -> None:
+        """Forget recorded calls for one tool (every scope), or for all tools."""
+        if tool_name is None:
+            self._states.clear()
+            return
+        for key in [k for k in self._states if k == tool_name or (isinstance(k, tuple) and k[0] == tool_name)]:
+            del self._states[key]
