     async def call_tool(
         self,
@@ -99,9 +134,34 @@ class ToolManager:
         context: Context[LifespanContextT, RequestT],
         convert_result: bool = False,
     ) -> Any:
-        """Call a tool by name with arguments."""
+        """Call a tool by name with arguments.
+
+        A tool with a limit policy is checked before it runs, and the call is
+        recorded only once the tool has returned: a failing call, or a round
+        that returns an `InputRequiredResult`, does not consume the budget.
+
+        Raises:
+            ToolError: If the tool is unknown, its limit policy denies the call,
+                or the tool itself fails (see `Tool.run`).
+        """
         tool = self.get_tool(name)
         if not tool:
             raise ToolError(f"Unknown tool: {name}")
 
-        return await tool.run(arguments, context, convert_result=convert_result)
+        policy = tool.limits
+        if policy is None:
+            return await tool.run(arguments, context, convert_result=convert_result)
+
+        scope_key = session_scope_key(context)
+        decision = self.enforcer.decide(name, policy, scope_key)
+        if not decision.allowed:
+            if decision.reason == "quota":
+                reason_text = "quota exhausted"
+            else:
+                reason_text = f"rate limit exceeded; retry after {decision.retry_after or 0.0:.3f}s"
+            raise ToolError(f"Tool '{name}' {reason_text}")
+
+        result = await tool.run(arguments, context, convert_result=convert_result)
+        if not isinstance(result, InputRequiredResult):
+            self.enforcer.record(name, policy, scope_key)
+        return result
