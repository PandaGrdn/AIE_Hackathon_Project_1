  "modules": {
    "test_discounts.py": "import pytest\nfrom pricing.discounts import discount_rate\n\n\ndef test_basic_zero_units():\n    assert discount_rate(\"basic\", 0) == 0.0\n\n\ndef test_basic_below_threshold():\n    assert discount_rate(\"basic\", 49) == 0.0\n\n\ndef test_basic_at_threshold():\n    assert discount_rate(\"basic\", 50) == 0.02\n\n\ndef test_basic_above_threshold():\n    assert discount_rate(\"basic\", 100) == 0.02\n\n\ndef test_plus_below_threshold():\n    assert discount_rate(\"plus\", 49) == 0.05\n\n\ndef test_plus_at_threshold():\n    assert discount_rate(\"plus\", 50) == 0.07\n\n\ndef test_plus_above_threshold():\n    assert discount_rate(\"plus\", 80) == 0.07\n\n\ndef test_pro_below_threshold():\n    assert discount_rate(\"pro\", 49) == 0.10\n\n\ndef test_pro_at_threshold():\n    assert discount_rate(\"pro\", 50) == 0.12\n\n\ndef test_invalid_tier_capitalized():\n    with pytest.raises(ValueError):\n        discount_rate(\"Basic\", 10)\n\n\ndef test_invalid_tier_whitespace():\n    with pytest.raises(ValueError):\n        discount_rate(\" plus\", 10)\n\n\ndef test_invalid_tier_empty():\n    with pytest.raises(ValueError):\n        discount_rate(\"\", 10)\n\n\ndef test_invalid_tier_unknown():\n    with pytest.raises(ValueError):\n        discount_rate(\"gold\", 10)\n\n\ndef test_negative_units():\n    with pytest.raises(ValueError):\n        discount_rate(\"basic\", -1)\n"
  },
