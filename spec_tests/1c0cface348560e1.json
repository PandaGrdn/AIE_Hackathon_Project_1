  "modules": {
    "test_shipping.py": "import pytest\nfrom shipping import shipping_fee\n\ndef test_zero_weight():\n    assert shipping_fee(0.0) == 5.00\n\ndef test_band_one_boundary():\n    assert shipping_fee(1.0) == 5.00\n\ndef test_band_two_just_above_one():\n    assert shipping_fee(1.01) == 9.00\n\ndef test_band_two_boundary():\n    assert shipping_fee(5.0) == 9.00\n\ndef test_band_three_just_above_five():\n    assert shipping_fee(5.01) == 15.00\n\ndef test_band_three_middle():\n    assert shipping_fee(12.5) == 15.00\n\ndef test_band_three_just_below_twenty():\n    assert shipping_fee(19.99) == 15.00\n\ndef test_band_four_boundary():\n    assert shipping_fee(20.0) == 20.00\n\ndef test_band_four_fractional_round_half_to_even():\n    assert shipping_fee(20.5) == 20.12\n\ndef test_band_four_maximum():\n    assert shipping_fee(1000.0) == 265.00\n\ndef test_negative_weight_raises():\n    with pytest.raises(ValueError):\n        shipping_fee(-0.1)\n\ndef test_exceeding_max_weight_raises():\n    with pytest.raises(ValueError):\n        shipping_fee(1000.01)\n"
