  "modules": {
    "test_fines.py": "import pytest\nfrom fines import late_fine, top_fined\n\n\ndef test_late_fine_book_on_time():\n    assert late_fine(0, \"book\") == 0.0\n\n\ndef test_late_fine_book_normal():\n    assert late_fine(3, \"book\") == 0.3\n\n\ndef test_late_fine_book_exact_cap():\n    assert late_fine(50, \"book\") == 5.0\n\n\ndef test_late_fine_book_over_cap():\n    assert late_fine(51, \"book\") == 5.0\n\n\ndef test_late_fine_dvd_normal():\n    assert late_fine(5, \"dvd\") == 5.0\n\n\ndef test_late_fine_dvd_cap():\n    assert late_fine(15, \"dvd\") == 10.0\n\n\ndef test_late_fine_laptop_normal():\n    assert late_fine(4, \"laptop\") == 20.0\n\n\ndef test_late_fine_laptop_cap():\n    assert late_fine(100, \"laptop\") == 50.0\n\n\ndef test_late_fine_negative_days_raises():\n    with pytest.raises(ValueError):\n        late_fine(-1, \"book\")\n\n\ndef test_late_fine_invalid_item_type_raises():\n    with pytest.raises(ValueError):\n        late_fine(2, \"Book\")\n\n\ndef test_top_fined_empty_dict():\n    assert top_fined({}, 5) == []\n\n\ndef test_top_fined_n_zero():\n    assert top_fined({\"Alice\": 5.0}, 0) == []\n\n\ndef test_top_fined_excludes_zero_fines():\n    assert top_fined({\"Alice\": 0.0, \"Bob\": 1.0}, 5) == [\"Bob\"]\n\n\ndef test_top_fined_order_by_amount_descending():\n    assert top_fined({\"Alice\": 5.0, \"Bob\": 10.0}, 2) == [\"Bob\", \"Alice\"]\n\n\ndef test_top_fined_tie_breaker_name_ascending():\n    assert top_fined({\"Bob\": 5.0, \"Alice\": 5.0}, 2) == [\"Alice\", \"Bob\"]\n\n\ndef test_top_fined_limits_to_n():\n    assert top_fined({\"Alice\": 5.0, \"Bob\": 10.0, \"Charlie\": 1.0}, 2) == [\"Bob\", \"Alice\"]\n\n\ndef test_top_fined_negative_n_raises():\n    with pytest.raises(ValueError):\n        top_fined({\"Alice\": 5.0}, -1)\n\n\ndef test_top_fined_negative_fine_raises():\n    with pytest.raises(ValueError):\n        top_fined({\"Alice\": -1.0}, 2)\n"
  },
