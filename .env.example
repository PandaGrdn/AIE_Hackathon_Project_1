# Copy to .env and fill in. Never commit .env.

# Subquadratic SubQ Snap — DECISIONS API, not chat (console.subq.ai).
# POST /v1/systemone with {model, state, questions} -> probabilities per choice. 384K context.
# Used for: root-cause step localization, failure-kind classification, "does this lesson generalize".
SUBQ_API_KEY=
SUBQ_BASE_URL=https://api.subq.ai/v1
SUBQ_MODEL=subq-snap-1.1
SUBQ_DECISIONS_URL=https://api.subq.ai/v1/systemone

# Meta Model API — swarm agents (dev.meta.ai). OpenAI-compatible at api.meta.ai.
# Verified ids: muse-spark-1.3 (recommended), muse-spark-1.2, muse-wonder-1.0. "muse-code" is NOT a model id.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_CODE=muse-wonder-1.0
META_MODEL_SPARK=muse-spark-1.3

# Google Gemini — text roles (decomposer, spec-test author, reflector) + swarm agent + embeddings.
# Verified working: gemini-3.8-flash, gemini-3.6-flash, gemini-4-argon; gemini-3.1-pro-preview needs api_version v1beta.
# gemini-2.5-pro is retired. Embeddings: gemini-embedding-2 or gemini-embedding-001, 3072 dims.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
TEXT_PROVIDER=gemini

# Anthropic — swarm agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

# MongoDB Atlas — lessons, failure regions, steps, trust, changelog, run manifests
MONGODB_URI=
MONGODB_DB=swarm

# Set to 1 to use the in-memory store instead of MongoDB (local dev / tests)
USE_MEMORY_STORE=1

# Swarm settings
SWARM_SIZE=6
AGENT_TIMEOUT_S=600
SANDBOX_BACKEND=worktree   # worktree | docker
