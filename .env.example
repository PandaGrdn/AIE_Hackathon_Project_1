# Copy to .env and fill in. Never commit .env.

# Subquadratic — reflector + long-context judge (console.subq.ai)
SUBQ_API_KEY=
SUBQ_BASE_URL=https://api.subq.ai/v1
SUBQ_MODEL=subq-snap-1.1

# Meta Model API — swarm agents (dev.meta.ai)
META_API_KEY=
META_BASE_URL=https://api.dev.meta.ai/v1
META_MODEL_CODE=muse-code
META_MODEL_SPARK=muse-spark

# Google Gemini — swarm agent + embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_EMBED_MODEL=gemini-embedding-001

# Anthropic — swarm agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# MongoDB Atlas — lessons, failure regions, steps, trust, changelog, run manifests
MONGODB_URI=
MONGODB_DB=swarm

# Set to 1 to use the in-memory store instead of MongoDB (local dev / tests)
USE_MEMORY_STORE=1

# Swarm settings
SWARM_SIZE=6
AGENT_TIMEOUT_S=600
SANDBOX_BACKEND=worktree   # worktree | docker
